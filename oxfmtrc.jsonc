{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "ignorePatterns": [
    // dprint owns these file types (see dprint.json); oxfmt owns JS/TS/CSS
    "**/*.json",
    "**/*.jsonc",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    // Tool-managed files
    ".claude/**",
    ".serena/**",
    ".pnpm-store/**",
    // Askama templates: `{{ ... }}` placeholders are not valid HTML/JS and get mangled
    "crates/kaiki_report/templates/**",
    // Generated by `napi build` / tsc (also gitignored)
    "napi/kaiki/index.js",
    "napi/kaiki/index.d.ts",
    "napi/kaiki/plugin-loader.js",
    "napi/kaiki/plugin-loader.d.ts",
    // Generated by wasm-bindgen (also gitignored)
    "wasm/kaiki_diff_wasm/pkg/**",
  ],
}
